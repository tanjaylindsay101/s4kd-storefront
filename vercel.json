{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/collections/:path*", "destination": "/index.html" },
    { "source": "/products/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/assets/revision/videos/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
